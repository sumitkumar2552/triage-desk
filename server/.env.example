# Copy this file to .env and fill in the values.

# Required. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Optional. Without it, triage falls back to offline keyword rules and the app
# still runs end to end. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Haiku is the cheap, fast default; swap for a larger model if the
# classification quality is not good enough on your data.
AI_MODEL=claude-haiku-4-5-20251001

PORT=4000
CORS_ORIGIN=http://localhost:5173
